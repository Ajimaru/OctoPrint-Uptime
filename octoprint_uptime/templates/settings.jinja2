<div id="settings_plugin_octoprint_uptime" class="form-horizontal">
    <fieldset>
        <legend>{{ _("Uptime") }}</legend>
        <p>{{ _("Display both system and OctoPrint uptime in the navbar, with optional compact toggling.") }}</p>
        <div id="uptime_note_container"
             data-note="{{ _('Uptime could not be determined on this system.') |e }}"
             style="display:none;
                    margin-bottom:10px"></div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_show_system">{{ _("System Uptime:") }}</label>
            <div class="controls">
                <label class="checkbox" for="plugin_uptime_show_system">
                    <input id="plugin_uptime_show_system"
                           type="checkbox"
                           data-bind="checked: settings.plugins.octoprint_uptime.show_system_uptime" />
                    {{ _("Show system uptime in navbar") }}
                </label>
                <p class="help-block">{{ _("When enabled, shows system uptime in the navbar.") }}</p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_show_octoprint">{{ _("OctoPrint Uptime:") }}</label>
            <div class="controls">
                <label class="checkbox" for="plugin_uptime_show_octoprint">
                    <input id="plugin_uptime_show_octoprint"
                           type="checkbox"
                           data-bind="checked: settings.plugins.octoprint_uptime.show_octoprint_uptime" />
                    {{ _("Show OctoPrint uptime") }}
                </label>
                <p class="help-block">{{ _("When enabled, shows OctoPrint uptime in the navbar.") }}</p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_icon_only">{{ _("Icon Only") }}</label>
            <div class="controls">
                <label class="checkbox" for="plugin_uptime_icon_only">
                    <input id="plugin_uptime_icon_only"
                           type="checkbox"
                           data-bind="checked: settings.plugins.octoprint_uptime.icon_only, enable: settings.plugins.octoprint_uptime.show_system_uptime() || settings.plugins.octoprint_uptime.show_octoprint_uptime()" />
                    {{ _("Show only the uptime icon in the navbar") }}
                </label>
                <p class="help-block">
                    {{ _("When enabled, hides the uptime text in the navbar to save space; the times stay visible in the tooltip.") }}
                </p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_compact">{{ _("Compact Display") }}</label>
            <div class="controls">
                <label class="checkbox" for="plugin_uptime_compact">
                    <input id="plugin_uptime_compact"
                           type="checkbox"
                           data-bind="checked: settings.plugins.octoprint_uptime.compact_display, enable: settings.plugins.octoprint_uptime.show_system_uptime() && settings.plugins.octoprint_uptime.show_octoprint_uptime() && !settings.plugins.octoprint_uptime.icon_only()" />
                    {{ _("Toggle between system and OctoPrint uptime in the navbar") }}
                </label>
                <p class="help-block">{{ _("When enabled, alternates system and OctoPrint uptime to save navbar space.") }}</p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_compact_interval">{{ _("Compact Toggle Interval (s)") }}</label>
            <div class="controls">
                <input id="plugin_uptime_compact_interval"
                       type="number"
                       class="span2"
                       min="5"
                       max="60"
                       data-bind="value: settings.plugins.octoprint_uptime.compact_toggle_interval_seconds, enable: settings.plugins.octoprint_uptime.compact_display() && settings.plugins.octoprint_uptime.show_system_uptime() && settings.plugins.octoprint_uptime.show_octoprint_uptime() && !settings.plugins.octoprint_uptime.icon_only()" />
                <p class="help-block">{{ _("Switch interval in compact mode (5-60 s).") }}</p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_format">{{ _("Display format") }}</label>
            <div class="controls">
                <select id="plugin_uptime_format"
                        data-bind="value: settings.plugins.octoprint_uptime.display_format"
                        class="span3">
                    <option value="full">{{ _("D + H + M + S (days + hours + minutes + seconds)") }}</option>
                    <option value="dhm">{{ _("D + H + M (days + hours + minutes)") }}</option>
                    <option value="dh">{{ _("D + H (days + hours)") }}</option>
                    <option value="d">{{ _("D (days only)") }}</option>
                    <option value="short">{{ _("Short (legacy, same as D + H)") }}</option>
                </select>
                <p class="help-block">{{ _("Choose uptime format for the navbar.") }}</p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_poll_interval">{{ _("Polling interval (s)") }}</label>
            <div class="controls">
                <input id="plugin_uptime_poll_interval"
                       type="number"
                       class="span2"
                       min="1"
                       max="120"
                       data-bind="value: settings.plugins.octoprint_uptime.poll_interval_seconds" />
                <p class="help-block">{{ _("API poll interval for navbar updates (default: 5 s).") }}</p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_debug">{{ _("Debug") }}</label>
            <div class="controls">
                <label class="checkbox" for="plugin_uptime_debug">
                    <input id="plugin_uptime_debug"
                           type="checkbox"
                           data-bind="checked: settings.plugins.octoprint_uptime.debug" />
                    {{ _("Enable debug logging (throttled)") }}
                </label>
                <p class="help-block">{{ _("When enabled, writes throttled debug logs.") }}</p>
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="plugin_uptime_throttle">{{ _("Debug throttle (s)") }}</label>
            <div class="controls">
                <input id="plugin_uptime_throttle"
                       type="number"
                       class="span2"
                       min="1"
                       max="120"
                       data-bind="value: settings.plugins.octoprint_uptime.debug_throttle_seconds" />
                <p class="help-block">{{ _("Minimum interval between debug log entries (s).") }}</p>
            </div>
        </div>
    </fieldset>
</div>
